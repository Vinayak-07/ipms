rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User documents — only the owner can read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Device documents — any authenticated user can read, anyone can write
    // (ESP32 writes via API route, which uses Admin SDK and bypasses rules)
    // The open write rule is for prototype flexibility only.
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow write: if true;

      // Device history sub-collection
      match /data/{docId} {
        allow read: if request.auth != null;
        allow write: if true;
      }
    }
  }
}
